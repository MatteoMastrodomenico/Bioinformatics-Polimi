# STEP 1: Read and validate a DNA sequence.
def read_sequence(name):
    while True:
        sequence = input(
            f"Enter sequence {name} (G, C, A, T only): "
        ).strip().upper()

        if sequence and all(base in "GCAT" for base in sequence):
            return sequence

        print("Invalid input: enter only G, C, A, T.")


# STEP 2: Read and validate an integer.
def read_integer(name):
    while True:
        try:
            return int(input(f"Enter {name}: "))
        except ValueError:
            print("Invalid input: enter an integer.")


X = read_sequence("X")
Y = read_sequence("Y")

n = len(X)
m = len(Y)

# STEP 3: Read the scoring parameters.
Match = read_integer("Match (example: 1)")
Mismatch = read_integer("Mismatch (example: -1)")

while True:
    Gap_Penalty = read_integer("Gap_Penalty (example: -2)")

    if Gap_Penalty < 0:
        break

    print("The gap penalty must be negative.")

# STEP 4: Create F with m + 2 rows and n + 2 columns.
# The top row contains X; the leftmost column contains Y.
F = [[0 for _ in range(n + 2)] for _ in range(m + 2)]

F[0][0] = 0
F[0][1] = "-"
F[1][0] = "-"
F[1][1] = 0

for j in range(n):
    F[0][j + 2] = X[j]

for i in range(m):
    F[i + 2][0] = Y[i]

# STEP 5: Initialize scores for alignment with an empty sequence.
for j in range(2, n + 2):
    F[1][j] = (j - 1) * Gap_Penalty

for i in range(2, m + 2):
    F[i][1] = (i - 1) * Gap_Penalty

# STEP 6: Fill the scoring matrix.
for i in range(2, m + 2):
    for j in range(2, n + 2):
        score = Match if X[j - 2] == Y[i - 2] else Mismatch

        diagonal = F[i - 1][j - 1] + score
        up = F[i - 1][j] + Gap_Penalty
        left = F[i][j - 1] + Gap_Penalty

        F[i][j] = max(diagonal, up, left)

# STEP 7: Trace back to reconstruct one optimal alignment.
aligned_X = []
aligned_Y = []

i = m + 1
j = n + 1

while i > 1 or j > 1:
    # At the top boundary, only a left move is possible.
    if i == 1:
        aligned_X.append(X[j - 2])
        aligned_Y.append("-")
        j -= 1

    # At the left boundary, only an upward move is possible.
    elif j == 1:
        aligned_X.append("-")
        aligned_Y.append(Y[i - 2])
        i -= 1

    else:
        score = Match if X[j - 2] == Y[i - 2] else Mismatch

        # Prefer diagonal, then up, then left when scores are tied.
        if F[i][j] == F[i - 1][j - 1] + score:
            aligned_X.append(X[j - 2])
            aligned_Y.append(Y[i - 2])
            i -= 1
            j -= 1

        elif F[i][j] == F[i - 1][j] + Gap_Penalty:
            aligned_X.append("-")
            aligned_Y.append(Y[i - 2])
            i -= 1

        else:
            aligned_X.append(X[j - 2])
            aligned_Y.append("-")
            j -= 1

# STEP 8: Reverse the alignment built during traceback.
aligned_X = "".join(reversed(aligned_X))
aligned_Y = "".join(reversed(aligned_Y))

markers = "".join(
    "|" if a == b else " " if "-" in (a, b) else "."
    for a, b in zip(aligned_X, aligned_Y)
)

# STEP 9: Build the complete output before printing.
width = max(
    len(str(cell))
    for row in F
    for cell in row
) + 2

output = [
    "",
    f"Sequence X: {X}   Length n = {n}",
    f"Sequence Y: {Y}   Length m = {m}",
    "",
    f"Matrix F: {m + 2} rows x {n + 2} columns",
    "X: horizontal. Y: vertical, in the leftmost column.",
    ""
]

# Include every row, preserving the Y labels on the left.
for row in F:
    output.append(
        "".join(str(cell).rjust(width) for cell in row)
    )

output.extend([
    "",
    "Optimal global alignment:",
    f"X: {aligned_X}",
    f"   {markers}",
    f"Y: {aligned_Y}",
    "",
    f"Optimal score: {F[m + 1][n + 1]}",
    "",
    "END OF RESULTS"
])

# STEP 10: Print the matrix and alignment in one operation.
print("\n".join(output), flush=True)
